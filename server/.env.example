# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/pairwise?retryWrites=true&w=majority

# Auth
JWT_SECRET=change-me-to-a-64-char-random-string
JWT_EXPIRES_IN=24h

# CORS
CLIENT_URL=http://localhost:5173

# AI
GEMINI_API_KEY=
GEMINI_MODEL=
AI_TIMEOUT_MS=4000
AI_TOP_N=5